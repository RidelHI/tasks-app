{
  "name": "tasks-app",
  "version": "0.0.0",
  "private": true,
  "description": "Task management app: NestJS REST API + Angular Material web client",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "dev:api": "npm run start:dev -w @tasks/api",
    "dev:web": "npm start -w @tasks/web",
    "migration:run": "npm run migration:run -w @tasks/api",
    "migration:revert": "npm run migration:revert -w @tasks/api",
    "db:up": "docker compose up --detach --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up --detach --wait db",
    "db:logs": "docker compose logs --follow db",
    "app:up": "docker compose --profile app up --build --detach --wait",
    "app:down": "docker compose --profile app down",
    "app:logs": "docker compose --profile app logs --follow"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "ssh2": false,
    "protobufjs": false,
    "@parcel/watcher": false,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
