# Optional overrides for compose.yaml (copy to .env). All values have defaults.
# Local development only: never reuse these credentials outside your machine.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=tasks
POSTGRES_DB=tasks
POSTGRES_PORT=5432

# The app in containers (`npm run app:up`).
# Port of the web app on localhost (default: 8080).
WEB_PORT=8080
# API log level: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# Serve Swagger UI at /api/docs: true | false (default: true)
SWAGGER_ENABLED=true
