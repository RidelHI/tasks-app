# Local development settings: copy to .env (git-ignored).
# Deployed environments inject these as real environment variables instead.
# Rules and defaults live in src/config/env.validation.ts.

# development | production | test (default: development)
NODE_ENV=development

# HTTP port (default: 3000)
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Serve Swagger UI at /api/docs: true | false (default: true)
SWAGGER_ENABLED=true

# Origins allowed to call the API from a browser (CORS), comma-separated, e.g.
# https://app.example.com. Empty (default): CORS disabled, the web app is served from the
# API's origin (Angular dev proxy, nginx in Docker).
CORS_ORIGINS=

# Rate limit per client IP: requests per window, then 429 (defaults: 100 per 60 seconds).
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Reverse proxies in front of the API (e.g. 1 behind nginx) whose X-Forwarded-For header is
# trusted to find the client IP. 0 (default): no proxy, the header is ignored.
TRUST_PROXY_HOPS=0

# PostgreSQL connection. These values match compose.yaml (`npm run db:up`).
# Host and port have defaults (localhost, 5432); the credentials are required.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tasks
DB_PASSWORD=tasks
DB_NAME=tasks
